<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Editar entrada</title>
</head>
<body>

    <h1>Editar entrada</h1>

    <form action="/TPE_WEB2/entrada/editar/<?= $entrada->id_entrada ?>" method="POST">

        <label>Valor final:</label>
        <input
            type="number"
            name="valor_final"
            value="<?= $entrada->valor_final ?>"
            required
        >

        <br><br>

        <label>Tipo de entrada:</label>
        <input
            type="text"
            name="tipo_entrada"
            value="<?= $entrada->tipo_entrada ?>"
            required
        >

        <br><br>

        <label>Descuento aplicado:</label>
        <input
            type="number"
            name="descuento_aplicado"
            value="<?= $entrada->descuento_aplicado ?>"
            required
        >

        <br><br>

        <label>Cliente:</label>
        <select name="id_cliente" required>

            <?php foreach ($clientes as $cliente): ?>
                <option
                    value="<?= $cliente->id_cliente ?>"
                    <?= $cliente->id_cliente == $entrada->CLIENTE_id_cliente ? 'selected' : '' ?>
                >
                    <?= $cliente->nombre ?>
                </option>
            <?php endforeach; ?>

        </select>

        <br><br>

        <button type="submit">Guardar cambios</button>

    </form>

</body>
</html>